{
  "name": "baixador",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "containers": [
    {
      "class_name": "Downloader",
      "image": "./container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DOWNLOADER", "class_name": "Downloader" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Downloader"] }]
}
